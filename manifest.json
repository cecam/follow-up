{
  "manifest_version": 3,
  "name": "follow-up",
  "description": "Guarda contactos de LinkedIn y organiza tus próximos seguimientos para no perder oportunidades importantes.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/app/manifest/background.ts",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/runtimes/content/hello-world.js",
        "src/runtimes/content/linkedin-feed-injector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
