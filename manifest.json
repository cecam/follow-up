{
  "manifest_version": 3,
  "name": "follow-up",
  "key": "static-key",
  "version": "1.0.0",
  "action": { "default_popup": "index.html" },
  "background": {
    "service_worker": "src/app/manifest/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["src/runtimes/content/hello-world.js"],
      "run_at": "document_idle"
    }
  ]
}
