{
  "manifest_version": 3,
  "name": "follow-up",
  "version": "1.0.0",
  "action": { "default_popup": "index.html" },
  "background": {
    "service_worker": "src/app/manifest/background.ts",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/runtimes/content/hello-world.js"]
    }
  ]
}
